# Copy this file to `.env` and adjust. NEVER commit the real `.env`.
# (Docker Compose reads the `environment:` section directly, so `.env` is
# only needed for the optional local-Python run method.)

# RabbitMQ connection (local run). In Docker this is amqp://guest:guest@rabbitmq:5672/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# SQLite database file (local run). In Docker: sqlite:////data/quickbite.db
DATABASE_URL=sqlite:///./quickbite.db

# Topology names (must match the assignment)
EXCHANGE_NAME=quickbite.orders
DEAD_LETTER_EXCHANGE=quickbite.dlx
DEAD_LETTER_QUEUE=orders.dead-letter.queue

# Reliability tuning
PREFETCH_COUNT=10
MAX_RETRIES=3

# Payment simulation: off | random | transient | permanent
# "off" (default) always succeeds. Use the others to demo retries / dead-lettering.
PAYMENT_FAIL_MODE=off

# API bind address for the local run
API_HOST=127.0.0.1
API_PORT=8000
